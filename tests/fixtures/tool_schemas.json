          "prod_name": {"type": "string", "description": "厂家名称"},
          "stat_time": {"type": "string", "description": "统计日期 (YYYY-MM-DD)"},
          "analysis_target": {
            "type": "string",
            "enum": ["all", "expansion", "constriction"],
            "description": "分析目标：all=全量(扩展+收缩)，expansion=仅扩展，constriction=仅收缩"
          }
        },
        "required": []
      }
    }
  },
  {
